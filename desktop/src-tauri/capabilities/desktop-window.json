{
  "identifier": "desktop-window",
  "description": "Window chrome only for the Desktop development gateway",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:5920/*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-decorations",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/lemeit/lemeit-sim*"
        },
        {
          "url": "https://wiki.lemeit.ar/sim/*"
        },
        {
          "url": "https://dwsim.org/"
        },
        {
          "url": "https://dwsim.org/tutorials/*"
        },
        {
          "url": "https://lemeit.ar/"
        }
      ]
    }
  ]
}
