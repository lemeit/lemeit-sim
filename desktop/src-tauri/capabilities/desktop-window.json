{
  "identifier": "desktop-window",
  "description": "Window chrome and project export for the Desktop development gateway",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:5920/*"
    ]
  },
  "permissions": [
    "allow-save-project-copy",
    "allow-open-project",
    "allow-save-pdf",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-decorations",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/lemeit/lemeit-sim*"
        },
        {
          "url": "https://wiki.lemeit.ar/sim/*"
        },
        {
          "url": "https://dwsim.org/"
        },
        {
          "url": "https://dwsim.org/tutorials/*"
        },
        {
          "url": "https://lemeit.ar/"
        }
      ]
    }
  ]
}
