{
  "productName": "ΣIM Desktop",
  "version": "0.53.4-alpha.3",
  "identifier": "ar.lemeit.sim.desktop",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ΣIM Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
