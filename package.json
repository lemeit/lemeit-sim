{
  "name": "lemeit-sim",
  "version": "0.51.5",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/js/*/*.mjs",
    "test:exports-browser": "node --test tests/browser/browser-exports.mjs",
    "build": "node deploy/build.mjs",
    "build:verified": "npm test && npm run build",
    "predeploy": "npm run build:verified",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir .build/dry-run"
  },
  "devDependencies": {
    "playwright": "1.60.0",
    "wrangler": "4.158.0"
  }
}
