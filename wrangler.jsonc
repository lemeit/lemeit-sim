{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lemeit-sim",
  "account_id": "4d66e081e02724f8cde0aedd23d50ab3",
  "main": ".build/worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "ENGINE_URL": "https://engine-sim.lemeit.ar",
    "DEBIAN_ENGINE_URL": "https://sim-debian.lemeit.ar"
  },
  "d1_databases": [{"binding":"SIM_AUTH_DB","database_name":"lemeit-sim-auth","database_id":"7a15efe9-d498-490f-9c69-8990103fcf56"}],
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  }
}
