      <DynamicPropertiesDescriptions>
        <Property>
          <Name>Flow Conductance</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Flow Conductance (inverse of Resistance) of this Unit Operation."</Data>
        </Property>
        <Property>
          <Name>Volume</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Cooler Volume"</Data>
        </Property>
        <Property>
          <Name>Minimum Pressure</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Minimum Dynamic Pressure for this Unit Operation."</Data>
        </Property>
        <Property>
          <Name>Initialize using Inlet Stream</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Initializes the volume content with information from the inlet stream, if the content is null."</Data>
        </Property>
        <Property>
          <Name>Reset Content</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Discards the current holdup at the next run step and builds it again as on a first run (see Initialize using Inlet Stream)."</Data>
        </Property>
        <Property>
          <Name>Ambient Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Ambient temperature for heat gain calculation (K)."</Data>
        </Property>
        <Property>
          <Name>Ambient UA Product</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Overall heat transfer coefficient times area for ambient heat exchange (W/K). Set to 0 to disable."</Data>
        </Property>
        <Property>
          <Name>Wall Thermal Mass</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Product of wall mass and specific heat capacity (J/K). Set to 0 to disable wall dynamics."</Data>
        </Property>
        <Property>
          <Name>Wall Temperature</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Current wall temperature (K). Used when wall thermal mass &gt; 0."</Data>
        </Property>
        <Property>
          <Name>Incompressible Liquid Holdup</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Liquid service: keep the mass that fills the volume (any vapour leaves with the liquid) and set the pressure the downstream valve needs to pass the inflow, instead of a volume flash (which fails or rings on a liquid-full holdup)"</Data>
        </Property>
      </DynamicPropertiesDescriptions>
